# Ultra Core Environment Variables Template
# Copy this to .env.local and fill in your actual values

# === Supabase Configuration ===
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# === Security ===
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# === Ultra Core Alerts (src/core/alerts.py) ===
# Set these to enable real-time Telegram notifications
# Setup: Create a bot at https://t.me/BotFather
#   1. Send /newbot -> choose name -> get TOKEN
#   2. Message your bot once, then GET:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#      -> extract "chat":{"id":...} value
ULTRA_ALERT_TELEGRAM_TOKEN=your_telegram_bot_token
ULTRA_ALERT_TELEGRAM_CHAT=your_telegram_chat_id

# Optional webhook alternative (ntfy.sh, Slack, Discord):
# ULTRA_ALERT_WEBHOOK=https://ntfy.sh/your-channel-name

# === AI Intelligence ===
NVIDIA_API_KEY=your_nvidia_api_key

# === Google OAuth ===
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# === Alpaca (Paper Trading) ===
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret

# === Atlas Funded Account ===
# Enable Atlas mode: enforces Atlas DD/daily-loss rules, uses portfolio_atlas
ULTRA_ATLAS_MODE=0
# evaluation | funded
ULTRA_ATLAS_PHASE=evaluation
# Atlas MCP API key (from https://mcp.atlasfunded.com)
ATLAS_MCP_KEY=your_atlas_mcp_key
